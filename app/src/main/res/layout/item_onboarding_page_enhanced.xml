<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Icon Container with Glass Effect -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="48dp">

        <!-- Glass Circle Background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_circle_with_border"
            android:elevation="8dp" />

        <!-- Animated Icon - Now using ImageView for vector drawables -->
        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/product_icon"
            android:scaleType="centerInside" />

        <!-- Fallback emoji text (hidden by default) -->
        <TextView
            android:id="@+id/iconText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="56sp"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Title with Glass Background -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_with_border"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        android:layout_marginBottom="24dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:letterSpacing="0.02" />

    </LinearLayout>

    <!-- Description with Glass Background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_with_border"
        android:padding="24dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/descText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#E8FFFFFF"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

</LinearLayout>