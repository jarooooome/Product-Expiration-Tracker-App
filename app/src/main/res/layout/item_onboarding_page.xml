<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Dark rounded square — per-page color set by adapter -->
    <androidx.cardview.widget.CardView
        android:id="@+id/iconCard"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:cardCornerRadius="48dp"
        app:cardElevation="18dp"
        app:cardBackgroundColor="#2D6A4F"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Illustrated icon — replaces emoji, fills card with generous padding -->
        <ImageView
            android:id="@+id/iconView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_onboarding_box"
            android:contentDescription="Onboarding icon" />

    </androidx.cardview.widget.CardView>

    <!-- Title — short, bold, left-aligned -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Track what expires."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/iconCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description — single line, quiet -->
    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add your products once. We&#8217;ll handle the rest."
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>