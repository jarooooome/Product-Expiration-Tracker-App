<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/productItemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp"
    android:minHeight="72dp">

    <!-- Product Image -->
    <ImageView
        android:id="@+id/productImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:background="#F5F5F5"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_default_product" />

    <!-- Product Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Product Name - REMOVED textColor -->
        <TextView
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Milk"
            android:textSize="18sp"
            android:textStyle="bold" />
        <!-- ✅ REMOVED: android:textColor="#333333" -->

        <!-- Expiry Date - REMOVED textColor -->
        <TextView
            android:id="@+id/productExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expires: Dec 25, 2024"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
        <!-- ✅ REMOVED: android:textColor="#666666" -->

        <!-- Days Left - REMOVED textColor -->
        <TextView
            android:id="@+id/productDaysLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 days left"
            android:textSize="12sp"
            android:background="#E8F5E9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="8dp" />
        <!-- ✅ REMOVED: android:textColor="#4CAF50" -->

    </LinearLayout>

    <!-- Status Indicator -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:background="#4CAF50"
        android:layout_marginStart="8dp" />

</LinearLayout>