<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/productItemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp"
    android:minHeight="72dp">

    <!-- Product Icon -->
    <TextView
        android:id="@+id/productIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/product_icon"
        android:textSize="24sp"
        android:gravity="center"
        android:background="@color/light_green"
        android:layout_marginEnd="16dp" />

    <!-- Product Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Product Name -->
        <TextView
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/milk"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray" />

        <!-- Expiry Date -->
        <TextView
            android:id="@+id/productExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expires_dec_25"
            android:textSize="14sp"
            android:textColor="@color/medium_gray"
            android:layout_marginTop="4dp" />

        <!-- Days Left (Optional) -->
        <TextView
            android:id="@+id/productDaysLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/five_days_left"
            android:textSize="12sp"
            android:textColor="#1B5E20"
            android:background="@color/light_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Status Indicator -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:background="@color/green"
        android:layout_marginStart="8dp" />

</LinearLayout>