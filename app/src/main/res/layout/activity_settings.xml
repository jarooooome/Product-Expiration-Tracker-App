<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="32dp"
                android:textColor="#1A1E2C" />

            <!-- User Profile Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="User Profile"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2C"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Name:"
                            android:textSize="16sp"
                            android:textColor="#666666" />

                        <TextView
                            android:id="@+id/userNameText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Loading..."
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/editNameButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#6200EE"
                            android:text="edit"
                            android:textSize="16sp"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/nameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Enter your name"
                        android:padding="16dp"
                        android:background="#F0F0F0"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/nameEditButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/saveNameButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Save"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#4CAF50"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/cancelNameButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Cancel"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#757575"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reminder Frequency Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reminder Frequency"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2C"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How many days before expiry should we notify you?"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/frequencyValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 days before"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#6200EE"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <SeekBar
                        android:id="@+id/reminderFrequencySeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="30"
                        android:progress="3"
                        android:progressTint="#6200EE"
                        android:thumbTint="#6200EE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Same day"
                            android:textSize="12sp"
                            android:textColor="#999999" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 days"
                            android:textSize="12sp"
                            android:textColor="#999999" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="30 days"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:gravity="right" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Vibration Pattern Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vibration Pattern"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2C"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/vibrationRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/vibration_default"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Default (recommended)"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:checked="true"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/vibration_short"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Short pulse"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/vibration_long"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Long pulse"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/vibration_none"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No vibration"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:paddingVertical="8dp" />

                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose how your device vibrates when you receive expiry notifications"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Theme Selection Card - UPDATED to only White and Black -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App Theme"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2C"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/themeRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/theme_white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="☀️ Light (default)"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:checked="true"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/theme_black"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🌙 Dark"
                            android:textSize="16sp"
                            android:textColor="#1A1E2C"
                            android:paddingVertical="8dp" />

                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose your preferred app color theme"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notification Time Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notification Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2C"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What time should we notify you?"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/notificationTimeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="9:00 AM"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#6200EE"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/notificationTimeButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Change Time"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6200EE" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#757575"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Save Settings"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6200EE"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Version Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0"
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/bottom_nav_gradient"
        android:elevation="12dp"
        android:paddingVertical="8dp">

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="#FFFFFF"
                android:contentDescription="Profile" />

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navProfileIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Products Button -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_products"
                app:tint="#FFFFFF"
                android:contentDescription="Products" />

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navProductsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings Button (Active) -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="#FFFFFF"
                android:contentDescription="Settings" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navSettingsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>