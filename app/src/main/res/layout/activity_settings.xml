<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="32dp" />
            <!-- REMOVED: android:textColor - will be set in Java -->

            <!-- Reminder Frequency Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/frequencyLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏰ Reminder Frequency"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <!-- REMOVED: android:textColor -->

                    <TextView
                        android:id="@+id/frequencyDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How many days before expiry should we notify you?"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor="#666666" -->

                    <TextView
                        android:id="@+id/frequencyValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 days before"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor -->

                    <SeekBar
                        android:id="@+id/reminderFrequencySeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="30"
                        android:progress="3"
                        android:progressTint="@color/color_primary_light"
                        android:thumbTint="@color/color_primary_light" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/sameDayText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Same day"
                            android:textSize="12sp" />
                        <!-- REMOVED: android:textColor="#999999" -->

                        <TextView
                            android:id="@+id/fifteenDaysText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 days"
                            android:textSize="12sp" />
                        <!-- REMOVED: android:textColor="#999999" -->

                        <TextView
                            android:id="@+id/thirtyDaysText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="30 days"
                            android:textSize="12sp"
                            android:gravity="right" />
                        <!-- REMOVED: android:textColor="#999999" -->
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Vibration Pattern Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/vibrationLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📳 Vibration Pattern"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor -->

                    <RadioGroup
                        android:id="@+id/vibrationRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/vibration_default"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Default (recommended)"
                            android:textSize="16sp"
                            android:checked="true"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                        <RadioButton
                            android:id="@+id/vibration_short"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Short pulse"
                            android:textSize="16sp"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                        <RadioButton
                            android:id="@+id/vibration_long"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Long pulse"
                            android:textSize="16sp"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                        <RadioButton
                            android:id="@+id/vibration_none"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No vibration"
                            android:textSize="16sp"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                    </RadioGroup>

                    <TextView
                        android:id="@+id/vibrationDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose how your device vibrates when you receive expiry notifications"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />
                    <!-- REMOVED: android:textColor="#666666" -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Theme Selection Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/themeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎨 App Theme"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor -->

                    <RadioGroup
                        android:id="@+id/themeRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Light Theme"
                            android:textSize="16sp"
                            android:checked="true"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                        <RadioButton
                            android:id="@+id/theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dark Theme"
                            android:textSize="16sp"
                            android:paddingVertical="8dp" />
                        <!-- REMOVED: android:textColor -->

                    </RadioGroup>

                    <TextView
                        android:id="@+id/themeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose your preferred app color theme"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />
                    <!-- REMOVED: android:textColor="#666666" -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notification Time Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/notificationLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏰ Notification Time"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <!-- REMOVED: android:textColor -->

                    <TextView
                        android:id="@+id/notificationDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What time should we notify you?"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor="#666666" -->

                    <TextView
                        android:id="@+id/notificationTimeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏰ 9:00 AM"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />
                    <!-- REMOVED: android:textColor -->

                    <Button
                        android:id="@+id/notificationTimeButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Change Time"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/color_primary_light" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />
                <!-- REMOVED: android:backgroundTint="#757575" - will be set in Java -->

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Save Settings"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />
                <!-- REMOVED: android:backgroundTint="@color/color_primary_light" - will be set in Java -->

            </LinearLayout>

            <!-- Version Info -->
            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />
            <!-- REMOVED: android:textColor="#999999" -->

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingVertical="8dp">
        <!-- REMOVED: android:background="@drawable/bottom_nav_gradient" - will be set in Java -->

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_myplaces" />
            <!-- REMOVED: app:tint="#FFFFFF" - will be set in Java -->

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />
            <!-- REMOVED: android:textColor="#FFFFFF" - will be set in Java -->

            <View
                android:id="@+id/navProfileIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
            <!-- REMOVED: android:background="#FFFFFF" - will be set in Java -->
        </LinearLayout>

        <!-- Products Button -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_view" />
            <!-- REMOVED: app:tint="#FFFFFF" - will be set in Java -->

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />
            <!-- REMOVED: android:textColor="#FFFFFF" - will be set in Java -->

            <View
                android:id="@+id/navProductsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
            <!-- REMOVED: android:background="#FFFFFF" - will be set in Java -->
        </LinearLayout>

        <!-- Settings Button (Active) -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_preferences" />
            <!-- REMOVED: app:tint="#FFFFFF" - will be set in Java -->

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />
            <!-- REMOVED: android:textColor="#FFFFFF" - will be set in Java -->

            <View
                android:id="@+id/navSettingsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
            <!-- REMOVED: android:background="#FFFFFF" - will be set in Java -->
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>