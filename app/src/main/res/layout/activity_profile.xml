<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    tools:context=".ProfileActivity">

    <!-- Scrollable Content - Everything except bottom nav -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="80dp">

            <!-- Header Section with Info Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <!-- Title + Subtitle -->
                <LinearLayout
                    android:id="@+id/headerTextBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="48dp">

                    <TextView
                        android:id="@+id/profileTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Profile"
                        android:textSize="32sp"
                        android:textColor="?attr/primaryTextColor"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/profileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track and manage your items"
                        android:textSize="16sp"
                        android:textColor="?attr/secondaryTextColor" />

                </LinearLayout>

                <!-- Info Button — top-right corner -->
                <ImageView
                    android:id="@+id/infoButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Information"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_info_button"
                    tools:ignore="TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck" />

            </RelativeLayout>

            <!-- Your Activity Section -->
            <TextView
                android:id="@+id/yourActivityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Activity"
                android:textSize="20sp"
                android:textColor="?attr/primaryTextColor"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <!-- First Row - Total Items and Safe -->
            <LinearLayout
                android:id="@+id/firstRowLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?attr/backgroundColor"
                android:layout_marginBottom="12dp">

                <!-- Total Items Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/total_items_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/total_items_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textColor="?attr/primaryTextColor"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/total_items_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Items"
                            android:textSize="14sp"
                            android:textColor="?attr/secondaryTextColor"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Safe Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/safe_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/safe_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textColor="?attr/safeColor"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/safe_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safe"
                            android:textSize="14sp"
                            android:textColor="?attr/secondaryTextColor"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Second Row - Expiring Soon and Expired -->
            <LinearLayout
                android:id="@+id/secondRowLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp">

                <!-- Expiring Soon Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/expiring_soon_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/expiring_soon_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textColor="?attr/warningColor"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/expiring_soon_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expiring Soon"
                            android:textSize="14sp"
                            android:textColor="?attr/secondaryTextColor"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Expired Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/expired_card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/cardBackgroundColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/expired_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textColor="?attr/expiredColor"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/expired_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expired"
                            android:textSize="14sp"
                            android:textColor="?attr/secondaryTextColor"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Categories Section -->
            <TextView
                android:id="@+id/categoriesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="20sp"
                android:textColor="?attr/primaryTextColor"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <!-- First Row of Categories - Dairy and Vegetables -->
            <LinearLayout
                android:id="@+id/categoriesFirstRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Dairy Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/dairy_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryDairyColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/dairy_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🥛"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dairy_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dairy"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dairy_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Vegetables Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/vegetables_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryVegetablesColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/vegetables_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🥦"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/vegetables_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vegetables"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/vegetables_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Second Row of Categories - Fruits and Meats -->
            <LinearLayout
                android:id="@+id/categoriesSecondRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Fruits Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/fruits_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryFruitsColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/fruits_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🍎"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/fruits_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fruits"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/fruits_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Meats Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/meats_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryMeatsColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/meats_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🥩"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/meats_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meats"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/meats_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Third Row of Categories - Beverages and Medicine -->
            <LinearLayout
                android:id="@+id/categoriesThirdRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Beverages Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/beverages_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryBeveragesColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/beverages_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🥤"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/beverages_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Beverages"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/beverages_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Medicine Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/medicine_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryMedicineColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/medicine_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="💊"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/medicine_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medicine"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/medicine_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Fourth Row of Categories - Other and Empty placeholder -->
            <LinearLayout
                android:id="@+id/categoriesFourthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp">

                <!-- Other Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/other_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/categoryOtherColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/other_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="📦"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/other_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other"
                                android:textSize="16sp"
                                android:textColor="?attr/primaryTextColor"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/other_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="13sp"
                                android:textColor="?attr/secondaryTextColor"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Empty placeholder for alignment -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Modern Floating Action Button (Add Product) -->
    <ImageView
        android:id="@+id/addButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomNavigation"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_fab_add"
        android:contentDescription="Add Product"
        android:background="@drawable/fab_modern_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp"
        app:tint="?attr/fabIconColor"
        android:scaleType="fitCenter" />

    <!-- Modern Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="?attr/bottomNavColor"
        android:elevation="12dp"
        android:paddingVertical="8dp">

        <!-- Profile Button (Active) -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="?attr/bottomNavIconColor" />

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="?attr/bottomNavTextColor"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navProfileIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="?attr/bottomNavIndicatorColor"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Products Button -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_products"
                app:tint="?attr/bottomNavIconColor" />

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textColor="?attr/bottomNavTextColor"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navProductsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="?attr/bottomNavIndicatorColor"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="?attr/bottomNavIconColor" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="?attr/bottomNavTextColor"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <View
                android:id="@+id/navSettingsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="?attr/bottomNavIndicatorColor"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>