<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Warning Dot (top right) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Product Image/Icon -->
            <ImageView
                android:id="@+id/productImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_product_placeholder"
                android:scaleType="centerCrop" />

            <!-- Warning Indicators (top right corner) -->
            <LinearLayout
                android:id="@+id/warningIndicators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Red dot for expired/expiring soon -->
                <View
                    android:id="@+id/redDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/circle_red"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />

                <!-- Yellow dots for warning -->
                <View
                    android:id="@+id/yellowDot1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/circle_yellow"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/yellowDot2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/circle_yellow"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/productName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Category Label (Optional) -->
        <TextView
            android:id="@+id/categoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Dairy"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Expiry Info -->
        <TextView
            android:id="@+id/expiryInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expires: Tomorrow"
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>