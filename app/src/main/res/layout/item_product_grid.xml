<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:id="@+id/productItemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Full-width image on top -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product image" />

            <!-- three-dot menu in top-right corner over the image -->
            <ImageView
                android:id="@+id/menuButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_more_vert"
                android:padding="6dp"
                android:background="@drawable/menu_button_bg"
                android:contentDescription="More options"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <!-- Text section below image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1E2C"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/productExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires: Jan 1, 2026"
                android:textSize="12sp"
                android:textColor="#8A8F9E"
                android:layout_marginTop="2dp" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/productDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_rounded" />

        </LinearLayout>

        <!-- Hidden - kept for adapter compatibility -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>