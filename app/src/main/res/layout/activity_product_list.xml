<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProductListActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/bottomNavigation"> <!-- Changed from @id to @+id -->

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:elevation="4dp">

            <!-- Title -->
            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Your Products"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- Category Filter Buttons -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categoryFilterLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/categoryAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="All"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/categoryFoodButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Food"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/categoryMedicineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Medicine"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/categoryDrinksButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Drinks"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/categoryOtherButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Other"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Product Count -->
        <TextView
            android:id="@+id/productCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 0 products"
            android:textSize="14sp"
            android:textColor="#757575"
            android:padding="16dp"
            android:paddingBottom="8dp" />

        <!-- Product List -->
        <ListView
            android:id="@+id/productListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingVertical="8dp">

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#757575" />

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Products Button (Active) -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="#757575" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Action Button (Add Product) -->
    <ImageView
        android:id="@+id/addButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomNavigation"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Product"
        android:background="@drawable/fab_background"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        app:tint="#FFFFFF" />
</RelativeLayout>