<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProductListActivity">

    <!-- Scrollable Content - Everything except bottom nav -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Modern Header - NO BACKGROUND ATTRIBUTE -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="20dp">

                <!-- Big "Hi, <user name>!" -->
                <TextView
                    android:id="@+id/hiUserTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hi, User! 👋"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.02" />

                <!-- Small welcome description -->
                <TextView
                    android:id="@+id/welcomeDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="these are your products"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:alpha="0.9"
                    android:layout_marginBottom="24dp"
                    android:letterSpacing="0.02" />

                <!-- Modern Search Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:elevation="4dp"
                    android:background="@drawable/search_bar_rounded_shadow">

                    <!-- Search Emoji -->
                    <TextView
                        android:id="@+id/searchEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:text="🔍"
                        android:textSize="20sp"
                        android:contentDescription="Search" />

                    <!-- Search EditText -->
                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/searchEmoji"
                        android:layout_toStartOf="@id/clearSearchButton"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Search products..."
                        android:textSize="16sp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1" />

                    <!-- Clear Search Button -->
                    <ImageView
                        android:id="@+id/clearSearchButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        android:contentDescription="Clear search"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </RelativeLayout>

                <!-- Category Label - Bold Text -->
                <TextView
                    android:id="@+id/categoryLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categories"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <!-- Category Filter Chips -->
                <HorizontalScrollView
                    android:id="@+id/categoryScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/category_container_background"
                    android:elevation="2dp">

                    <LinearLayout
                        android:id="@+id/categoryFilterLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <!-- All Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryAllButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryAllTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/categoryAllCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="12sp"
                                android:alpha="0.7"
                                android:layout_marginTop="4dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Dairy Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryDairyButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryDairyIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥛"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryDairyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dairy"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryDairyCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Vegetables Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryVegetablesButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryVegetablesIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥦"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryVegetablesTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vegetables"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryVegetablesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Fruits Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryFruitsButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryFruitsIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍎"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryFruitsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fruits"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryFruitsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Meats Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryMeatsButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryMeatsIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥩"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryMeatsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meats"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryMeatsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Beverages Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryBeveragesButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryBeveragesIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥤"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryBeveragesTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Beverages"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryBeveragesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Medicine Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryMedicineButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryMedicineIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💊"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryMedicineTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medicine"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryMedicineCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <!-- Other Category Button -->
                        <LinearLayout
                            android:id="@+id/categoryOtherButton"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:paddingHorizontal="8dp"
                            android:background="@drawable/category_button_square_curve"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/categoryOtherIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📦"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/categoryOtherTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/categoryOtherCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 items"
                                android:textSize="11sp"
                                android:alpha="0.7"
                                android:layout_marginTop="2dp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- BULK ACTION BAR - ADDED HERE -->
            <LinearLayout
                android:id="@+id/bulkActionLayout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="#2196F3"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/bulkActionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 item(s) selected"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bulkSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select All"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/bulkDiscard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discard"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginHorizontal="8dp" />

                <TextView
                    android:id="@+id/bulkCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Product Count with modern styling and History Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="?attr/colorPrimary"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/productCountText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total: 0 products"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <!-- History Button - Right side of product count -->
                <ImageView
                    android:id="@+id/historyButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_history"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="History"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Product List with RecyclerView -->
            <com.example.productexpirationtrackerapp.WrapContentRecyclerView
                android:id="@+id/productRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Modern Bottom Navigation Bar - NO BACKGROUND ATTRIBUTE -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:elevation="12dp"
        android:paddingVertical="8dp">

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_myplaces" />

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <!-- Profile Indicator -->
            <View
                android:id="@+id/navProfileIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Products Button (Active) -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_view" />

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <!-- Products Indicator -->
            <View
                android:id="@+id/navProductsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_preferences" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <!-- Settings Indicator -->
            <View
                android:id="@+id/navSettingsIndicator"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modern Floating Action Button (Add Product) -->
    <ImageView
        android:id="@+id/addButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomNavigation"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Product"
        android:background="@drawable/fab_modern_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp"
        android:scaleType="fitCenter" />

</RelativeLayout>