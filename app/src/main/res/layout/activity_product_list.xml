<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProductListActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/bottomNavigation">

        <!-- Modern Header with Gradient Effect -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:elevation="8dp"
            android:background="@drawable/header_gradient">

            <!-- Title with modern styling -->
            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Your Products"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.02"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp" />

            <!-- Modern Search Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/search_bar_background"
                android:elevation="2dp">

                <!-- Search Icon -->
                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#FFFFFF"
                    android:contentDescription="Search" />

                <!-- Search EditText -->
                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/searchIcon"
                    android:layout_toStartOf="@id/clearSearchButton"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:hint="Search products..."
                    android:textColorHint="#B3FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />

                <!-- Clear Search Button -->
                <ImageView
                    android:id="@+id/clearSearchButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFFFFF"
                    android:visibility="gone"
                    android:contentDescription="Clear search"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <!-- Category Filter Chips with modern styling -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/categoryFilterLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/categoryAllButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="All"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/category_chip_background"
                        android:backgroundTint="#FFFFFF"
                        android:textAllCaps="false"
                        android:letterSpacing="0.05"
                        android:elevation="3dp" />

                    <Button
                        android:id="@+id/categoryFoodButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🍎 Food"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/category_chip_background"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false"
                        android:letterSpacing="0.05"
                        android:elevation="3dp" />

                    <Button
                        android:id="@+id/categoryMedicineButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="💊 Medicine"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/category_chip_background"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false"
                        android:letterSpacing="0.05"
                        android:elevation="3dp" />

                    <Button
                        android:id="@+id/categoryDrinksButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🥤 Drinks"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/category_chip_background"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false"
                        android:letterSpacing="0.05"
                        android:elevation="3dp" />

                    <Button
                        android:id="@+id/categoryOtherButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="📦 Other"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="20dp"
                        android:background="@drawable/category_chip_background"
                        android:backgroundTint="#80FFFFFF"
                        android:textAllCaps="false"
                        android:letterSpacing="0.05"
                        android:elevation="3dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Product Count with modern styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:background="?attr/colorPrimary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/productCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: 0 products"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Product List with modern card style -->
        <ListView
            android:id="@+id/productListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Modern Bottom Navigation Bar with gradient -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/bottom_nav_gradient"
        android:elevation="12dp"
        android:paddingVertical="8dp">

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Products Button (Active) -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navProductsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/navProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />

            <!-- Active indicator -->
            <View
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modern Floating Action Button (Add Product) -->
    <ImageView
        android:id="@+id/addButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomNavigation"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Product"
        android:background="@drawable/fab_modern_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp"
        app:tint="#FFFFFF"
        android:scaleType="fitCenter" />
</RelativeLayout>