<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="32dp">

        <!-- Header wrapper — Java uses headerCard for setCardBackgroundColor -->
        <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <!-- Hidden icon — kept so Java's headerIcon ref doesn't crash -->
                <ImageView
                    android:id="@+id/headerIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:src="@drawable/ic_palette"
                    app:tint="#4CAF50" />

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/subtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set up your preferences to get started"
                    android:textSize="14sp"
                    android:textColor="#757575" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ YOUR PROFILE ══════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/sectionLabelProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR PROFILE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="12dp" />

        <!-- Name wrapper — Java uses nameCard for setCardBackgroundColor -->
        <androidx.cardview.widget.CardView
            android:id="@+id/nameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:id="@+id/userNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What should we call you?"
                    android:textSize="13sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/userNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter your name (max 8 letters)"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#9E9E9E"
                    android:inputType="textPersonName"
                    android:maxLength="8"
                    android:maxLines="1"
                    android:background="@android:color/transparent" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- ══ APP THEME ═════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/sectionLabelTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APP THEME"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/themeDescText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your preferred color theme"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="14dp" />

        <!-- Theme wrapper — Java uses themeCard for setCardBackgroundColor -->
        <androidx.cardview.widget.CardView
            android:id="@+id/themeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp">

                <!-- Hidden label — kept so Java's themeLabel ref doesn't crash -->
                <TextView
                    android:id="@+id/themeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/optionWhiteLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/theme_option_background"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/themeWhite"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="☀️  Light (Default)"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/optionBlackLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/theme_option_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/themeBlack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌙  Dark"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp" />
                    </LinearLayout>

                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- ══ NOTIFICATIONS ═════════════════════════════════════════════ -->
        <!-- Hidden section label — kept so Java's sectionLabelNotif ref doesn't crash -->
        <TextView
            android:id="@+id/sectionLabelNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- Hidden description text — kept so Java's notifDescText ref doesn't crash -->
        <TextView
            android:id="@+id/notifDescText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get alerts before your products expire"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Notification wrapper — Java uses notificationCard for setCardBackgroundColor -->
        <androidx.cardview.widget.CardView
            android:id="@+id/notificationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp">

                <!-- Hidden label — kept so Java's notificationLabel ref doesn't crash -->
                <TextView
                    android:id="@+id/notificationLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/notificationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/notificationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enable expiry reminders"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:visibility="gone" />

                    <Switch
                        android:id="@+id/notificationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="#4CAF50"
                        android:trackTint="#AAAAAA"
                        android:alpha="0.0"
                        android:clickable="false"
                        android:focusable="false"
                        tools:ignore="TouchTargetSizeCheck" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:visibility="gone" />

        <!-- ── Finish Button ─────────────────────────────────────────── -->
        <Button
            android:id="@+id/finishButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Finish Setup"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/finish_button_background"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>