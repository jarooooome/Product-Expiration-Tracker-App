<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Main background with default gradient -->
    <FrameLayout
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/onboarding_gradient">

        <!-- Glass overlay for depth -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_overlay"
            android:alpha="0.1" />

        <!-- Main content -->
        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Theme Preview Header with Glass Border -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="24dp"
                android:layout_marginBottom="32dp"
                android:elevation="6dp">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/customize_your_app"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/subtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_theme"
                    android:textSize="16sp"
                    android:textColor="#E0FFFFFF"
                    android:gravity="center" />

            </LinearLayout>

            <!-- User Name Section with Glass Border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/userNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_name"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/userNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_name"
                    android:padding="16dp"
                    android:background="@drawable/glass_input_with_border"
                    android:textColor="#FFFFFF"
                    android:hintTextColor="#80FFFFFF"
                    android:inputType="textPersonName"
                    android:importantForAutofill="yes"
                    android:autofillHints="name" />

            </LinearLayout>

            <!-- Color Theme Selection with Glass Border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/themeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_color_theme"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <!-- Theme Selection using RadioGroup -->
                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- White/Light Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/themeWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/light_default"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                    <!-- Green Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/themeGreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/green"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                    <!-- Blue Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/themeBlue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/blue"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                    <!-- Pink Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/themePink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pink"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                    <!-- Purple Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/themePurple"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/purple"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                    <!-- Black/Dark Theme -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/glass_theme_item"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp">

                        <RadioButton
                            android:id="@+id/themeBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dark_theme"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />

                    </LinearLayout>

                </RadioGroup>
            </LinearLayout>

            <!-- Notifications Section with Glass Border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/notificationLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notificationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enable_expiry_reminders"
                        android:textSize="16sp"
                        android:textColor="#E0FFFFFF"
                        android:gravity="center_vertical" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notificationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:checked="true" />

                </LinearLayout>
            </LinearLayout>

            <!-- Debug Database Button -->
            <Button
                android:id="@+id/debugDbButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/debug_database"
                android:textColor="#80FFFFFF"
                android:background="@android:color/transparent"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Finish Button with Glass Border -->
            <Button
                android:id="@+id/finishButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/finish_setup"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/glass_button_with_border"
                android:layout_marginBottom="12dp"
                android:elevation="8dp" />

            <!-- Skip Button (Use Default Theme) -->
            <Button
                android:id="@+id/skipSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skip_setup"
                android:textSize="16sp"
                android:textColor="#80FFFFFF"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>