<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".AddProductActivity">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Add New Product"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- NEW: SCAN PRODUCT BUTTON - Added here -->
        <Button
            android:id="@+id/btnScanProduct"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📷 SCAN PRODUCT WITH CAMERA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:layout_marginBottom="24dp" />

        <!-- Product Photo Section -->
        <TextView
            android:id="@+id/photoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product Photo (Optional)"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Photo Preview -->
            <ImageView
                android:id="@+id/productPhotoPreview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="#F0F0F0"
                android:scaleType="centerCrop"
                android:contentDescription="Product photo preview"
                android:layout_marginBottom="16dp" />

            <!-- Photo Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/takePhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📸 Take Photo"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/choosePhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🖼️ Choose from Gallery"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Remove Photo Button (hidden by default) -->
            <Button
                android:id="@+id/removePhotoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove Photo"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/productNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product Name *"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/productNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter product name"
            android:padding="16dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="24dp" />

        <!-- Expiry Date -->
        <TextView
            android:id="@+id/expiryDateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Date *"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/expiryDateEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="YYYY-MM-DD"
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="date" />

            <Button
                android:id="@+id/datePickerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="18sp"
                android:layout_marginStart="8dp"
                android:padding="16dp" />

        </LinearLayout>

        <!-- Category (Optional) -->
        <TextView
            android:id="@+id/categoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category (Optional)"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="24dp" />

        <!-- Quantity (Optional) -->
        <TextView
            android:id="@+id/quantityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity (Optional)"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/quantityEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 1, 2, 500g, 1L"
            android:padding="16dp"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <!-- Notes (Optional) -->
        <TextView
            android:id="@+id/notesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes (Optional)"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/notesEditText"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Any additional notes..."
            android:padding="16dp"
            android:background="@drawable/edittext_background"
            android:gravity="top"
            android:layout_marginBottom="32dp" />

        <!-- Add & Cancel Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Save Product"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>