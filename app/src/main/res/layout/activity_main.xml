<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background ImageView -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Background" />

    <!-- White overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- Logo Container with ET Logo and Waves -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Circular Waves Container -->
            <FrameLayout
                android:id="@+id/waveContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Wave 4 (outermost) -->
                <View
                    android:id="@+id/wave4"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_wave"
                    android:scaleX="0.2"
                    android:scaleY="0.2"
                    android:alpha="0.3" />

                <!-- Wave 3 -->
                <View
                    android:id="@+id/wave3"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_wave"
                    android:scaleX="0.2"
                    android:scaleY="0.2"
                    android:alpha="0.4" />

                <!-- Wave 2 -->
                <View
                    android:id="@+id/wave2"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_wave"
                    android:scaleX="0.2"
                    android:scaleY="0.2"
                    android:alpha="0.5" />

                <!-- Wave 1 (innermost) -->
                <View
                    android:id="@+id/wave1"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_wave"
                    android:scaleX="0.2"
                    android:scaleY="0.2"
                    android:alpha="0.6" />

                <!-- ET Logo -->
                <FrameLayout
                    android:id="@+id/logoCenter"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@drawable/et_logo_background"
                    android:elevation="8dp">

                    <!-- Logo Text -->
                    <TextView
                        android:id="@+id/logoText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="ET"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium" />

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ExpiryTrack"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:visibility="invisible" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track. Save. Sustain."
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:visibility="invisible" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Progress bar -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp">

            <View
                android:id="@+id/progressTrack"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_gravity="center_vertical"
                android:background="#E0E0E0" />

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/progress_fill_blue" />

        </FrameLayout>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing app..."
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal" />

        <!-- Icons -->
        <LinearLayout
            android:id="@+id/iconsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/icon1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                android:layout_marginHorizontal="8dp"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/icon2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_inventory"
                android:layout_marginHorizontal="8dp"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/icon3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notification"
                android:layout_marginHorizontal="8dp"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/icon4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chart"
                android:layout_marginHorizontal="8dp"
                android:visibility="invisible" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SKIP"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="32dp"
                android:visibility="invisible"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="24dp"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>