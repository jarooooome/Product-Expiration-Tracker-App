<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Main background with default gradient -->
    <FrameLayout
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/onboarding_gradient">

        <!-- Glass overlay for depth -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_overlay"
            android:alpha="0.1" />

        <!-- Main content -->
        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Progress Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step_1_of_3"
                    android:textSize="14sp"
                    android:textColor="#E0FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <View
                        android:id="@+id/progressBar1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_active" />

                    <View
                        android:id="@+id/progressBar2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_inactive" />

                    <View
                        android:id="@+id/progressBar3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/progress_inactive" />

                </LinearLayout>

            </LinearLayout>

            <!-- Theme Preview Header with Glass Border -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="24dp"
                android:layout_marginBottom="20dp"
                android:elevation="6dp">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/customize_your_app"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/subtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_theme"
                    android:textSize="16sp"
                    android:textColor="#E0FFFFFF"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Live Preview Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:elevation="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#80667EEA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_preview_label"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/previewProductName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_product_name"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/previewExpiryDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_expiry_days"
                        android:textSize="14sp"
                        android:textColor="#E0FFFFFF" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- User Name Section with Glass Border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/your_name"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_number_1"
                        android:textSize="20sp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/userNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_your_name"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@drawable/glass_input_with_border"
                    android:inputType="textPersonName"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- Theme Selection with Glass Border -->
            <LinearLayout
                android:id="@+id/themePreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/choose_color_theme"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_number_2"
                        android:textSize="20sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_input_with_border"
                    android:padding="16dp">

                    <RadioGroup
                        android:id="@+id/themeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Light/White Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themeWhite"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#FFFFFF"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/light_default"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Green Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themeGreen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#4CAF50"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/green"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Blue Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themeBlue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#2196F3"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/blue"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Pink Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themePink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#E91E63"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/pink"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Purple Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themePurple"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#9C27B0"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/purple"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Dark/Black Theme -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/themeBlack"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#FFFFFF"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dark_theme"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Notifications Section with Glass Border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_with_border"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notifications"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_number_3"
                        android:textSize="20sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/notificationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enable_expiry_reminders"
                        android:textSize="16sp"
                        android:textColor="#E0FFFFFF"
                        android:gravity="center_vertical" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notificationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:checked="true" />

                </LinearLayout>

                <!-- Notification Days Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_input_with_border"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_timing_label"
                        android:textSize="14sp"
                        android:textColor="#E0FFFFFF"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/notificationDaysText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_alert_days"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <SeekBar
                        android:id="@+id/notificationDaysSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="6"
                        android:progress="2"
                        android:progressTint="#FFFFFF"
                        android:thumbTint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/min_alert_days"
                            android:textSize="12sp"
                            android:textColor="#80FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/max_alert_days"
                            android:textSize="12sp"
                            android:textColor="#80FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Debug Database Button -->
            <Button
                android:id="@+id/debugDbButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/debug_database"
                android:textColor="#80FFFFFF"
                android:background="@android:color/transparent"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Finish Button with Glass Border -->
            <Button
                android:id="@+id/finishButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/finish_setup"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/glass_button_with_border"
                android:layout_marginBottom="12dp"
                android:elevation="8dp" />

            <!-- Skip Button (Use Default Theme) -->
            <Button
                android:id="@+id/skipSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skip_setup"
                android:textSize="16sp"
                android:textColor="#80FFFFFF"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>