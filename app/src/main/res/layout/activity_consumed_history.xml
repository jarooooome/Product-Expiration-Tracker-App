<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ConsumedHistoryActivity">

    <!-- ── Header ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back_arrow"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="History"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

    </LinearLayout>

    <!-- ── Stats row ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Total -->
        <LinearLayout
            android:id="@+id/statCardTotal"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/statDivider1"
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="#DDDDDD"
            android:layout_marginEnd="6dp" />

        <!-- Consumed -->
        <LinearLayout
            android:id="@+id/statCardConsumed"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvConsumedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />

            <TextView
                android:id="@+id/tvConsumedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSUMED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#4CAF50"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/statDivider2"
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="#DDDDDD"
            android:layout_marginEnd="6dp" />

        <!-- Discarded -->
        <LinearLayout
            android:id="@+id/statCardDiscarded"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDiscardedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#E53935" />

            <TextView
                android:id="@+id/tvDiscardedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCARDED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#E53935"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Thin divider ───────────────────────────────────────────────── -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <!-- ── Filter tabs ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/filterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- All tab -->
        <LinearLayout
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <View
                android:id="@+id/indicatorAll"
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Consumed tab -->
        <LinearLayout
            android:id="@+id/btnConsumed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvConsumed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumed"
                android:textSize="14sp"
                android:letterSpacing="0.02" />

            <View
                android:id="@+id/indicatorConsumed"
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Discarded tab -->
        <LinearLayout
            android:id="@+id/btnDiscarded"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvDiscarded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discarded"
                android:textSize="14sp"
                android:letterSpacing="0.02" />

            <View
                android:id="@+id/indicatorDiscarded"
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Bottom divider under tabs ─────────────────────────────────── -->
    <View
        android:id="@+id/tabDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ── RecyclerView ───────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- ── Empty state ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_history_empty"
            android:alpha="0.3" />

        <TextView
            android:id="@+id/emptyTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No history yet"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/emptySubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Products you consume or discard will appear here"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />

    </LinearLayout>

</LinearLayout>