<?xml version="1.0" encoding="utf-8"?>
<!--
    PULSE GLOW ANIMATION
    Subtle breathing/glowing effect

    Features:
    - Gentle scale pulsing (0.95x to 1.05x)
    - Opacity variation for glow effect
    - 2-second smooth cycle
    - Infinite loop

    Usage: Apply to logo circle for breathing effect
    📁 Location: res/anim/pulse_glow.xml

    Replaces: pulse_animation.xml (enhanced version)
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="1.0"
        android:duration="2000"
        android:repeatMode="reverse"
        android:repeatCount="infinite"
        android:interpolator="@android:anim/accelerate_decelerate_interpolator" />

    <scale
        android:fromXScale="0.95"
        android:toXScale="1.05"
        android:fromYScale="0.95"
        android:toYScale="1.05"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="2000"
        android:repeatMode="reverse"
        android:repeatCount="infinite"
        android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
</set>